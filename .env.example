# MicroHistory API Keys
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Required for --auto mode (AI visual generation via Gemini Imagen)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Required for --auto mode (TTS narration)
# Get yours at: https://elevenlabs.io → Settings → API Keys
ELEVENLABS_API_KEY=

# Optional: ElevenLabs voice ID (default: "pNInz6obpgDQGcFmaJgB" / Adam)
# Browse voices at elevenlabs.io/voice-library
# ELEVENLABS_VOICE_ID=
